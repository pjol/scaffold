# Generated by `scaffold env --write` from scaffold.json. Edit scaffold.json, not this file.
# dev-up writes the real file from scaffold.json and .env.dev; ENV.md explains each variable.

# --- core ---
# Backend origin the app calls. dev-up uses the machine's LAN IP so devices can reach it. [required:always]
EXPO_PUBLIC_API_URL=
# development, staging or production.
EXPO_PUBLIC_APP_ENV=development
# Default palette id from packages/tokens.
EXPO_PUBLIC_PALETTE=base
# Public web origin for links the app shares (invites, events, posts) and opens (legal pages, wallet linking). [required:prod]
EXPO_PUBLIC_WEB_URL=

# --- auth ---
# Show the dev identity picker instead of Clerk (non-production only).
EXPO_PUBLIC_AUTH_DEV=true
# Clerk publishable key. Unset in development = dev sign-in only. [required:prod]
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Generated by `scaffold env --write` from scaffold.json. Edit scaffold.json, not this file.
# dev-up writes the real file from scaffold.json and .env.dev; ENV.md explains each variable.

# --- core ---
# Backend origin the browser calls. [required:always]
NEXT_PUBLIC_API_URL=
# development, staging or production (gates dev auth in the browser).
NEXT_PUBLIC_APP_ENV=development
# Default palette id from packages/tokens.
NEXT_PUBLIC_PALETTE=base

# --- auth ---
# Clerk secret for Next's Clerk middleware (server only). [required:prod, secret]
CLERK_SECRET_KEY=
# Show the dev identity picker instead of Clerk (non-production only).
NEXT_PUBLIC_AUTH_DEV=true
# Clerk publishable key. Unset in development = dev sign-in only. [required:prod]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- storage ---
# Public bucket origin, the same value as the backend's S3_PUBLIC_URL. Lets next/image optimise avatars and uploads; unset = they load unoptimised.
NEXT_PUBLIC_S3_PUBLIC_URL=

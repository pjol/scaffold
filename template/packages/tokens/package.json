{
  "name": "@scaffoldapp/tokens",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./motion": "./src/motion.ts",
    "./layout": "./src/layout.ts",
    "./registry": "./src/registry.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/generated/tokens.css",
    "./palettes.json": "./src/generated/palettes.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "check": "node scripts/check.mjs",
    "contrast": "node scripts/check.mjs --report"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}

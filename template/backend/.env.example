# Generated by `scaffold env --write` from scaffold.json. Edit scaffold.json, not this file.
# dev-up writes the real file from scaffold.json and .env.dev; ENV.md explains each variable.

# --- core ---
# development, staging or production. Gates the dev auth bypass, strict migrations and required secrets.
APP_ENV=development
# Comma-separated browser origins allowed to call the API and open sockets. [required:prod]
CORS_ALLOWED_ORIGINS=
# Oldest Android build allowed; older builds show the update screen.
MOBILE_MIN_VERSION_ANDROID=1.0.0
# Oldest iOS build allowed; older builds show the update screen.
MOBILE_MIN_VERSION_IOS=1.0.0
# HTTP port. dev-up assigns it from the project's port block.
PORT=8080
# Public origin of this API (upload URLs, links). https in production. [required:prod]
PUBLIC_API_URL=http://localhost:8080
# Public origin of the web app (email links, redirects, Clerk authorized party). [required:prod]
PUBLIC_WEB_URL=
# Requests per minute per client IP on /v1.
RATE_LIMIT_IP_PER_MIN=600
# Requests per minute per signed-in user.
RATE_LIMIT_USER_PER_MIN=300
# New WebSocket connections per minute per IP.
RATE_LIMIT_WS_PER_MIN=60
# Realtime broker across instances. Unset = in-memory (one instance). [secret]
REDIS_URL=
# Per-request timeout for /v1 routes (Go duration).
REQUEST_TIMEOUT=20s
# Run module background workers on this instance.
RUN_WORKERS=true
# Published support address (settings, footer, store listings).
SUPPORT_EMAIL=support@example.com
# Proxies in front of the API that append X-Forwarded-For (0 = use the TCP peer).
TRUSTED_PROXY_HOPS=0

# --- database ---
# Postgres connection URL. [required:always, secret]
DATABASE_URL=
# Pool size per instance.
DB_MAX_CONNS=20

# --- auth ---
# Comma-separated emails granted admin at sign-in.
ADMIN_EMAILS=admin@scaffoldapp.test
# Accept dev:<subject>:<email> tokens. Refused unless APP_ENV=development.
AUTH_DEV_BYPASS=true
# Clerk backend key. Optional in development when AUTH_DEV_BYPASS is on. [required:prod, secret]
CLERK_SECRET_KEY=
# Svix signing secret for /webhooks/clerk (user.updated, user.deleted). [required:prod, secret]
CLERK_WEBHOOK_SECRET=

# --- storage ---
# Upload directory when S3_BUCKET is unset (development).
LOCAL_UPLOAD_DIR=.data/uploads
# Access key id (unset = default AWS credential chain). [secret]
S3_ACCESS_KEY_ID=
# Bucket for uploads. Unset = local disk (development only). [required:prod]
S3_BUCKET=
# Endpoint for non-AWS providers (R2, Tigris, MinIO).
S3_ENDPOINT=
# Path-style addressing (MinIO).
S3_FORCE_PATH_STYLE=false
# Public base URL for public-read objects (CDN or bucket URL). [required:prod]
S3_PUBLIC_URL=
# Bucket region.
S3_REGION=us-east-1
# Secret access key. [secret]
S3_SECRET_ACCESS_KEY=

# --- email ---
# From header for transactional mail; the domain must be verified in Resend.
MAIL_FROM=Scaffold App <no-reply@example.com>
# Development: write each email as a Markdown file here instead of logging it.
MAIL_SINK_DIR=.data/mail
# Resend key. Unset = mail is logged, not sent (development). [required:prod, secret]
RESEND_API_KEY=

# --- observability ---
# info or debug.
LOG_LEVEL=info

# Generated by `scaffold env --write` from scaffold.json. Edit scaffold.json, not this file.
# .env.dev is read only by scripts/dev-up (copied from this file on first run) and is
# never sourced: scripts/dev-up/env.mjs parses it and writes each value into the runtime
# file of every tier that declares the name (backend/.env, web/.env.local, mobile/.env).
# Every key is optional in development; blank means unset (dev fallbacks apply). X here
# also fills NEXT_PUBLIC_X / EXPO_PUBLIC_X. Flags win over this file; PORT, DATABASE_URL
# and APP_ENV always belong to dev-up. Below: dev-up settings, then the provider keys
# you may paste to use real services locally (test-mode keys only).

# --- core ---
# Realtime broker across instances. Unset = in-memory (one instance).
REDIS_URL=

# --- auth ---
# Clerk publishable key, pasted once: dev-up copies it to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
# Clerk backend key. Optional in development when AUTH_DEV_BYPASS is on.
CLERK_SECRET_KEY=
# Svix signing secret for /webhooks/clerk (user.updated, user.deleted).
CLERK_WEBHOOK_SECRET=

# --- storage ---
# Access key id (unset = default AWS credential chain).
S3_ACCESS_KEY_ID=
# Bucket for uploads. Unset = local disk (development only).
S3_BUCKET=
# Secret access key.
S3_SECRET_ACCESS_KEY=

# --- email ---
# Resend key. Unset = mail is logged, not sent (development).
RESEND_API_KEY=

# --- dev ---
# LAN IP that --lan/--tunnel write into EXPO_PUBLIC_API_URL and PUBLIC_API_URL. Unset = detected from the default network interface.
DEV_LAN_IP=
# Directory holding Postgres 17 initdb/pg_ctl/psql. Unset = /Library/PostgreSQL/17/bin, Homebrew, Postgres.app, then PATH; none found = docker compose.
DEV_PG_BIN=
# First port of this project's local block (API +0, web +1, Postgres +2, Metro +3, MinIO +4, Redis +5, hooks +6…+9). Unset = derived from the slug; never 3000-3010 or 8080.
DEV_PORT_BASE=

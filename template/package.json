{
  "name": "scaffoldapp",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "dev:mobile": "pnpm --dir mobile start",
    "typecheck": "pnpm -r --parallel typecheck",
    "tokens": "pnpm --filter @scaffoldapp/tokens tokens",
    "check": "pnpm --filter @scaffoldapp/tokens check && pnpm --filter @scaffoldapp/shared check"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
